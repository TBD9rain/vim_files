#===================================================================================================
#
#   Target Code : Do Script (TCL)
#   Version     : 1.0.0
#
#   Description
#
#   Additional info
#       Get instruction with ":help UltiSnips".
#       Use "snippet" or "sn" to trigger snippet for snippet edition.
#
#   Author  : TBD9rain
#
#===================================================================================================

snippet simulate "QuestaSim 10.6c Verilog simulation script" Ab
#============================================
#   QuestaSim 10.6c Verilog Simulation Script
#============================================

#------------------
#   Define Variable
#------------------

# when sim_time == 0, run all
set sim_time        ${2:100}

set tb_module       ${3:tb_name}$0


#-------------------------
#   Prepare for Simulation
#-------------------------

# quit simulation
quit -sim
# clear commands
# .main clear

# delete previous temporary data directory
if {[file exists work]} {
	file delete -force work
}

# create directory for temporary data
vlib work

# map logical library and directory
vmap work ./work


#---------------
#   Compile Code
#---------------

# "+incdir+<directory>": specify directories to search "\`include" files
# "+define+<marco_name>[=<macro_text>]": define or override a macro

vlog -work work\
	-f file_list.txt

if {$sim_time <= 0} {
	vopt -64 -O4 $tb_module -o opt_tb
} else {
	vopt -64 -O4 +acc $tb_module -o opt_tb
}


#-------------------
#   Start Simulation
#-------------------

# "-onfinish stop": use $stop when $finish

# "-G<param_name>=<param_value>": to assign or override a parameter

# "-L <device_lib>": for post simulation and timing simulation
# "-sdftyp <sdf_file>": for timing simulation
# "+transport_int_delays" and "+transport_path_delays" for timing simulation
# "+typdelays" or "+maxdelays" or "+mindelays" for timing simulation

vsim -lib work\
	-onfinish stop\
	pt_tb\
	-t 1ps -l sim.log


#-----------------
#   Run Simulation
#-----------------

set UserTimeUnit ns
if {$sim_time <= 0} {
	run -all
	simstats
} else {
	# add waveform
	if {[file exists wave.do]} {
		do wave.do
	}

	# run set interval
	run $sim_time

	# set step run length
	set RunLength 1000

	# wave window display adjustment
	wave zoom full
	configure wave -timelineunits ns
}

endsnippet

